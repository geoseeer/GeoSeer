{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.geoseeer/geoseer",
  "title": "GeoSeer",
  "description": "GeoSeer AI image geolocation — geoseeer.com",
  "repository": {
    "url": "https://github.com/geoseeer/GeoSeer",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "geoseeer",
      "version": "0.3.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "geoseeer[mcp]==0.3.0"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEOSEER_API_KEY",
          "description": "GeoSeer API key from the account dashboard.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
